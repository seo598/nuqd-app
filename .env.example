# ─────────────────────────────────────────────────────────────
# NUQD app configuration. Copy to `.env.local` and adjust.
# NEVER commit real secrets — .env.local is gitignored.
# All client-exposed vars MUST be prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Display name shown in the UI.
NEXT_PUBLIC_APP_NAME=NUQD

# Base currency used for balance formatting.
NEXT_PUBLIC_BASE_CURRENCY=USD

# Mock API tuning — simulated network latency (ms) and failure rate (0–1)
# so you can exercise loading and error states without a real backend.
NEXT_PUBLIC_MOCK_LATENCY_MS=550
NEXT_PUBLIC_MOCK_ERROR_RATE=0

# When you wire a real backend, put its URL here (server-side only, no NEXT_PUBLIC_).
# API_BASE_URL=https://api.nuqd.example
# API_KEY=__do_not_commit__
